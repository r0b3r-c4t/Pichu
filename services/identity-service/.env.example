HOST=0.0.0.0
PORT=3001
DOCUMENTATION_URL=http://localhost:3001/docs
RESEND_API_KEY=re_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
RESEND_FROM_EMAIL=no-reply@example.com
RESEND_FROM_NAME=PICHU
EMAIL_VERIFICATION_URL=http://localhost:3000/verify-email
EMAIL_VERIFICATION_TOKEN_TTL_SECONDS=86400
PASSWORD_RESET_URL=http://localhost:3000/reset-password
PASSWORD_RESET_TOKEN_TTL_SECONDS=3600
NODE_ENV=development
JWT_SECRET=replace-with-at-least-32-byte-local-secret-value
JWT_ISSUER=pichu-identity-service
JWT_AUDIENCE=pichu-api
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
AUTH_COOKIE_ORIGIN=http://localhost:3000
DATABASE_URL=mongodb://identity_user:replace-with-url-encoded-identity-password@localhost:27018/identity_db?authSource=identity_db&directConnection=true
# Integration tests only. Set locally in the process environment; never use identity_db here.
# IDENTITY_TEST_DATABASE_URL=mongodb://<test-user>:<url-encoded-password>@127.0.0.1:27018/identity_test_db?authSource=identity_test_db&replicaSet=pichu-rs&directConnection=true
# test:integration can also use existing MONGO_INITDB_ROOT_USERNAME/PASSWORD loaded locally.
# Directed v2 keyring only; use synthetic values locally and keep real keys outside Git.
INTERNAL_AUTH_ENVIRONMENT=development
INTERNAL_AUTH_KEYRING_JSON=[{"environment":"development","sender":"vehicle-service","audience":"identity-service","keyId":"dev-vehicle-identity-active","secretBase64Url":"AwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwM","notBefore":1700000000000,"notAfter":1900000000000,"state":"active"},{"environment":"development","sender":"device-service","audience":"identity-service","keyId":"dev-device-identity-active","secretBase64Url":"BQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQU","notBefore":1700000000000,"notAfter":1900000000000,"state":"active"}]
INTERNAL_AUTH_BODY_LIMIT=1048576
# TLS_CERT_PATH=/absolute/path/to/identity-cert.pem
# TLS_KEY_PATH=/absolute/path/to/identity-key.pem
# TLS_CA_PATH=/absolute/path/to/pichu-ca.pem
