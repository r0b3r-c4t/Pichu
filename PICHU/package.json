{
  "name": "pichu",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/generate-pwa-precache.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "cap:sync": "pnpm run build && cap sync",
    "cap:android": "pnpm run cap:sync && cap open android",
