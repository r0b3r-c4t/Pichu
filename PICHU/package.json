    "cap:run:android": "pnpm run build && cap run android",
    "cap:run:ios": "pnpm run build && cap run ios"
  },
  "dependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/core": "8.6.0",
    "@capacitor/ios": "8.6.0",
    "lucide-react": "^1.66.0",
    "next": "^16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.10.0",
    "@types/react": "~19.3.0",
    "@types/react-dom": "^19.2.3",
    "eslint": "9.39.5",
    "eslint-config-next": "^16.4.3",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3"
  }
}
