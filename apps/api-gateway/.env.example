HOST=0.0.0.0
PORT=3000
NODE_ENV=development
INTERNAL_SERVICE_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
JWT_SECRET=replace-with-at-least-32-byte-local-secret-value
JWT_ISSUER=pichu-identity-service
JWT_AUDIENCE=pichu-api
VEHICLE_SERVICE_URL=http://127.0.0.1:3002
DEVICE_SERVICE_URL=http://127.0.0.1:3003
IDENTITY_SERVICE_URL=http://127.0.0.1:3001
PROXY_TIMEOUT_MS=5000
CORS_ORIGINS=http://localhost:3000
MAX_PAYLOAD_BYTES=1048576
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_SECONDS=60
SENSITIVE_RATE_LIMIT_MAX=20
